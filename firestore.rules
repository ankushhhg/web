rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Admin check: strictly from a trusted source (not a claim)
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'anksh2307@gmail.com'
      ); 
    }

    // --- User Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['user', 'admin'] &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidUser(incoming()) && (
        incoming().role == 'user' || (incoming().role == 'admin' && request.auth.token.email == 'anksh2307@gmail.com')
      );
      allow update: if isVerified() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'mobile']) &&
         (incoming().name == null || (incoming().name is string && incoming().name.size() <= 100))) ||
        isAdmin()
      );
    }

    // --- Product Validation ---
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'category', 'price', 'stock', 'image', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() <= 200 &&
             data.category is string &&
             data.image is string && data.image.size() <= 1000 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.createdAt is timestamp &&
             data.updatedAt == request.time;
    }

    match /products/{productId} {
      allow read: if true;
      allow list: if true; // Products are public catlog
      allow create: if isAdmin() && isValidProduct(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidProduct(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    // --- Order Validation ---
    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['pending', 'approved', 'rejected', 'delivered'] &&
             data.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidOrder(incoming()) && incoming().status == 'pending';
      allow update: if isAdmin() && (
        incoming().diff(existing()).affectedKeys().hasAny(['status', 'deliveryDate'])
      );
    }

    // --- Admin Collection (for bootstrap) ---
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable through Firebase Console or internal bootstrap
    }
  }
}
